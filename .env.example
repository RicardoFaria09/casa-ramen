# Chaves do EmailJS (https://www.emailjs.com/) usadas para o formulario de
# reservas enviar um email real. Copiar este ficheiro para ".env" e
# preencher com os valores da propria conta EmailJS (Service ID, Template
# ID e Public Key). O ".env" nunca deve ser commitado (ver .gitignore).
VITE_EMAILJS_SERVICE_ID=o_teu_service_id
VITE_EMAILJS_TEMPLATE_ID=o_teu_template_id
VITE_EMAILJS_PUBLIC_KEY=a_tua_public_key
